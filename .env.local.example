# Copy to .env.local (git-ignored) and fill in. NEVER commit real tokens, and
# NEVER prefix these NEXT_PUBLIC_ — they must stay server-side only.

# Apify token — powers the Instagram, TikTok, AND X follower scrapers
# (/api/instagram-followers, /api/tiktok-followers, /api/x-followers). Apify is
# usage-billed (cents per lookup) — far cheaper than X's official API.
APIFY_API_TOKEN=
# Optional: scraper actors (defaults shown). Swap if your actor returns a
# different follower field.
# APIFY_TIKTOK_ACTOR=clockworks~tiktok-profile-scraper
# APIFY_X_ACTOR=apidojo~twitter-user-scraper

# YouTube Data API v3 key (/api/youtube-followers). FREE within a 10,000-unit/day
# quota (~10k lookups/day). Create at console.cloud.google.com → enable "YouTube
# Data API v3" → API key.
YOUTUBE_API_KEY=

# X_BEARER_TOKEN — NO LONGER USED. X follower lookups now go through Apify
# (APIFY_API_TOKEN above) to avoid X's $200–$5,000/mo official API. The official
# X API v2 implementation is preserved in git history if you ever want it back.
# X_BEARER_TOKEN=

# --- LLM sentiment engine (/api/sentiment-llm) ---
# Anthropic is the default provider. Set ANTHROPIC_API_KEY and you're done —
# uses claude-haiku-4-5. Until a key is set, sentiment stays neutral (reach-only).
ANTHROPIC_API_KEY=

# FREE options — sentiment is a simple classification, so a free model is fine:
#   Groq (recommended, no credit card, Llama-70B, fast):
#     SENTIMENT_PROVIDER=groq
#     GROQ_API_KEY=gsk_...          (get one free at console.groq.com)
#   Google Gemini (free tier):
#     SENTIMENT_PROVIDER=google
#     GOOGLE_API_KEY=...            (get one free at aistudio.google.com)
# GROQ_API_KEY=
# GOOGLE_API_KEY=

# Provider layer — switch model/provider with env only, no code change:
#   SENTIMENT_PROVIDER   anthropic (default) | groq | google | deepseek | openai | openai-compatible
#   SENTIMENT_MODEL      provider-appropriate model id (optional; sensible default per provider)
#   SENTIMENT_API_KEY    the provider's key (or the per-provider env above, e.g. GROQ_API_KEY)
#   SENTIMENT_BASE_URL   base URL for a generic openai-compatible endpoint
#
# Examples:
#   Groq (free):  SENTIMENT_PROVIDER=groq       GROQ_API_KEY=gsk_...       (model defaults to llama-3.3-70b-versatile)
#   Gemini(free): SENTIMENT_PROVIDER=google     GOOGLE_API_KEY=...         (model defaults to gemini-2.0-flash)
#   Claude Opus:  SENTIMENT_MODEL=claude-opus-4-8                          (keep provider anthropic)
#   DeepSeek:     SENTIMENT_PROVIDER=deepseek   DEEPSEEK_API_KEY=sk-...    (model defaults to deepseek-chat)
#   OpenAI:       SENTIMENT_PROVIDER=openai     OPENAI_API_KEY=sk-...      SENTIMENT_MODEL=gpt-4o-mini
# SENTIMENT_PROVIDER=anthropic
# SENTIMENT_MODEL=
# SENTIMENT_API_KEY=
# SENTIMENT_BASE_URL=
